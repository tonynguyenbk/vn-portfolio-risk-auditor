# Normalise every text file to LF in the working tree.
#
# This is not cosmetic. `backend/scripts/fetch_market_data.py` writes the demo
# CSVs with explicit LF endings and records their SHA-256 in manifest.json. If
# Git checked those files out with CRLF on Windows, the checksum verification
# (`backend/scripts/verify_demo_data.py`) would fail for a reason that has
# nothing to do with the data.
* text=auto eol=lf

# Binary files Git must not touch.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary

# Generated lockfiles: keep them out of diffs and language statistics.
package-lock.json linguist-generated=true -diff
uv.lock linguist-generated=true -diff

# The frozen demonstration dataset is data, not source.
frontend/public/demo/*.csv linguist-generated=true -diff
# Committed research datasets: pinned by the SHA-256 in their manifest.
research/**/*.csv linguist-generated=true -diff
